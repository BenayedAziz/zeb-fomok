# Copie ce fichier en .env.local pour lancer l'appli sur ton ordi.
# Sur Vercel, ces variables se règlent dans Settings > Environment Variables.
# Sans les variables Supabase, l'appli tourne en "mode démo" : données gardées dans le navigateur, pas de comptes.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète, uniquement côté serveur (jamais NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# IA principale : Hugging Face > Settings > Access Tokens (Fine-grained, « Make calls to Inference Providers »).
# Sert aussi à la dictée vocale (Whisper).
HF_TOKEN=
# Modèle de chat (Inference Providers, API compatible OpenAI)
HF_LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
# Modèle pour l'import depuis les outils (par défaut : HF_LLM_MODEL)
HF_LLM_IMPORT_MODEL=
# Ordre des fournisseurs : vide = Hugging Face d'abord s'il est configuré, sinon Anthropic. Mettre "anthropic" pour l'inverse.
AI_PROVIDER=

# Secours facultatif : Anthropic > console.anthropic.com > API Keys (règle aussi la limite de dépense dans Billing > Limits)
ANTHROPIC_API_KEY=
# Modèle utilisé pour ranger (rapide et peu cher)
AI_MODEL=claude-haiku-4-5
# Nombre de rangements IA par personne et par jour
AI_DAILY_LIMIT=60

# Emails autorisés à se connecter (séparés par des virgules). Vide = tout le monde peut créer un compte.
ALLOWED_EMAILS=

# Adresse publique du site (ex. https://second-cerveau.vercel.app), utilisée pour les liens de connexion et les retours OAuth
NEXT_PUBLIC_SITE_URL=
# Phrase secrète pour chiffrer les connexions temporaires aux outils
IMPORT_SECRET=
# Modèle utilisé pour l'import depuis les outils (par défaut : AI_MODEL)
AI_IMPORT_MODEL=

# Connexions aux outils (voir docs/SETUP.md, étape 5). Vides = carte « Bientôt disponible ».
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Dictée vocale avec Whisper : utilise HF_TOKEN ci-dessus (sinon dictée du navigateur)
# Modèle de transcription (par défaut openai/whisper-large-v3)
HF_ASR_MODEL=
# Ou l'adresse complète d'un modèle déployé à toi (Inference Endpoint)
HF_ASR_URL=
